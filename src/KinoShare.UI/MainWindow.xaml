<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KinoShare.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:KinoShare.UI"
    xmlns:vm="using:KinoShare.UI.ViewModels"
    mc:Ignorable="d"
    Title="KinoDrop">

    <Grid x:Name="RootElement">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid
            x:Name="TitleBarElement"
            Grid.Row="0"
            Padding="20,0,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Glyph="&#xE7C8;"
                FontSize="18"
                Foreground="{ThemeResource AccentBrush}" />
            <TextBlock
                Grid.Column="1"
                Text="KinoDrop"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextStyle}"
                FontWeight="SemiBold" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: tagline + status pill + theme toggle -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Share files between this PC and your iPhone" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock
                        Text="Uses Windows' built-in SMB server — nothing is installed on the phone."
                        Style="{StaticResource SubtitleTextStyle}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Fill="{x:Bind local:UiVisuals.SessionDotBrush(ViewModel.Status), Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
                            Style="{StaticResource BodyTextStyle}"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ThemeToggleCommand}"
                    Style="{StaticResource SecondaryButtonStyle}">
                    <FontIcon
                        FontSize="14"
                        Glyph="{x:Bind local:UiVisuals.ThemeGlyph(ViewModel.IsDarkTheme), Mode=OneWay}" />
                </Button>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Info / error bar -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=OneWay}"
                        IsClosable="True"
                        CloseButtonClick="InfoBar_CloseButtonClick"
                        Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                        Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                        IsIconVisible="True" />

                    <!-- Session card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Session" Style="{StaticResource SectionHeaderStyle}" />
                                <ProgressRing
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}"
                                    Visibility="{x:Bind local:UiVisuals.BoolToVisibility(ViewModel.IsStarting), Mode=OneWay}" />
                            </Grid>

                            <!-- Credentials -->
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="SMB path"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBox
                                        x:Name="SmbPathBox"
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.SmbPath, Mode=OneWay}"
                                        Style="{StaticResource MonoCredentialStyle}" />
                                    <Button
                                        x:Name="CopySmbButton"
                                        Grid.Column="2"
                                        Content="Copy"
                                        Click="CopyField_Click"
                                        Tag="smb"
                                        Style="{StaticResource CopyButtonStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="Username"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.Username, Mode=OneWay}"
                                        Style="{StaticResource MonoCredentialStyle}" />
                                    <Button
                                        x:Name="CopyUserButton"
                                        Grid.Column="2"
                                        Content="Copy"
                                        Click="CopyField_Click"
                                        Tag="user"
                                        Style="{StaticResource CopyButtonStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="Password"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.Password, Mode=OneWay}"
                                        Style="{StaticResource MonoCredentialStyle}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Content="Edit…"
                                            Click="EditPassword_Click"
                                            IsEnabled="{x:Bind ViewModel.CanEditPassword, Mode=OneWay}"
                                            Style="{StaticResource CopyButtonStyle}" />
                                        <Button
                                            x:Name="CopyPassButton"
                                            Content="Copy"
                                            Click="CopyField_Click"
                                            Tag="password"
                                            Style="{StaticResource CopyButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border
                                Background="White"
                                Padding="10"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                Visibility="{x:Bind local:UiVisuals.BoolToVisibility(ViewModel.ShowQr), Mode=OneWay}">
                                <Image
                                    Width="168"
                                    Height="168"
                                    Source="{x:Bind ViewModel.QrCodeSource, Mode=OneWay}" />
                            </Border>

                            <TextBlock
                                Text="Scan the QR with your iPhone camera, then tap the Files notification — the address is filled in automatically. Connect → Registered User → enter the password (once; Files remembers it)."
                                Visibility="{x:Bind local:UiVisuals.BoolToVisibility(ViewModel.ShowQr), Mode=OneWay}"
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="iPhone: Files app → Connect to Server → enter the SMB path. Choose 'Registered User' (NOT Guest). The password is the same every session — your iPhone remembers it after the first connect. If the phone says 'Content Unavailable', you connected as Guest or the password changed."
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{x:Bind ViewModel.TransferFolderPath, Mode=OneWay}"
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap" />

                            <!-- Action bar -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="Start"
                                    Command="{x:Bind ViewModel.StartSessionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button
                                    Content="Stop"
                                    Command="{x:Bind ViewModel.StopSessionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                                <Button
                                    Content="Send file…"
                                    Click="SendFile_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                                <Button
                                    Content="Change folder…"
                                    Click="ChangeFolder_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                                <Button
                                    Content="Open folder"
                                    Click="OpenFolder_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- In-progress transfers -->
                    <Border
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind local:UiVisuals.BoolToVisibility(ViewModel.HasActiveTransfers), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="In progress" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.ActiveTransfers, Mode=OneWay}"
                                MaxHeight="160"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActiveTransferEntry">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Glyph="{x:Bind local:UiVisuals.DirectionGlyph(IsReceived)}"
                                                    Foreground="{x:Bind local:UiVisuals.DirectionBrush(IsReceived)}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind FileName}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                                    <ProgressRing
                                                        Width="14"
                                                        Height="14"
                                                        IsIndeterminate="True" />
                                                    <TextBlock
                                                        Text="{x:Bind StatsText, Mode=OneWay}"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar
                                                Height="6"
                                                Minimum="0"
                                                Maximum="{x:Bind ProgressMaximum, Mode=OneWay}"
                                                Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Transfers feed -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Transfers" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                                MaxHeight="240"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransferEntry">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind local:UiVisuals.DirectionGlyph(IsReceived)}"
                                                Foreground="{x:Bind local:UiVisuals.DirectionBrush(IsReceived)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind FileName}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind SizeText}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind TimeText}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Folder contents -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Transfer folder" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.FolderFiles, Mode=OneWay}"
                                MaxHeight="240"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileEntry">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Glyph="&#xE8A5;"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind SizeText}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind ModifiedText}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

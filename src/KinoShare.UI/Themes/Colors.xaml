<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand accent: indigo/violet -->
    <Color x:Key="AccentColor">#7C4DFF</Color>
    <Color x:Key="AccentDarkColor">#B388FF</Color>
    <Color x:Key="AccentLightColor">#651FFF</Color>
    <Color x:Key="AccentSubtleColor">#E8E0FF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <!-- Status colors -->
    <Color x:Key="StatusSuccessColor">#2E7D32</Color>
    <Color x:Key="StatusSuccessDarkColor">#81C784</Color>
    <Color x:Key="StatusFailureColor">#C62828</Color>
    <Color x:Key="StatusFailureDarkColor">#E57373</Color>
    <Color x:Key="StatusIdleColor">#9E9E9E</Color>
    <Color x:Key="StatusIdleDarkColor">#BDBDBD</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessDarkBrush" Color="{StaticResource StatusSuccessDarkColor}" />
    <SolidColorBrush x:Key="StatusFailureBrush" Color="{StaticResource StatusFailureColor}" />
    <SolidColorBrush x:Key="StatusFailureDarkBrush" Color="{StaticResource StatusFailureDarkColor}" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="{StaticResource StatusIdleColor}" />
    <SolidColorBrush x:Key="StatusIdleDarkBrush" Color="{StaticResource StatusIdleDarkColor}" />

</ResourceDictionary>

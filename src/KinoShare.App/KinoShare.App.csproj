<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KinoShare</AssemblyName>
    <RootNamespace>KinoShare.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KinoShare.Core\KinoShare.Core.csproj" />
    <ProjectReference Include="..\KinoShare.Infrastructure\KinoShare.Infrastructure.csproj" />
  </ItemGroup>

</Project>
